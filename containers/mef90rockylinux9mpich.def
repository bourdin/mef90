Bootstrap: docker
From: rockylinux:9 

### bbserv:containers (dmplex)$ apptainer build --force --sandbox /tmp/mef90rockylinux9mpich mef90rockylinux9mpich.def 

%setup


%environment
export PETSC_DIR=/opt/HPC/petsc
export PETSC_ARCH=arch-rocky-mpich-O
export PATH=$PETSC_DIR/bin:$PETSC_DIR/$PETSC_ARCH/bin:$PATH
export MEF90_DIR=/opt/HPC/mef90
export PATH=$MEF90_DIR/$PETSC_ARCH/bin:$MEF90_DIR/bin:$PATH
export PYTHONPATH=$MEF90_DIR/python:$PETSC_DIR/$PETSC_ARCH/lib:$PYTHONPATH
# export GMSH_DIR=/opt/HPC/gmsh-4.13.1-Linux64
# export PATH=$PATH:$GMSH_DIR/bin
# export VISIT_DIR=/opt/HPC/visit
# export PATH=$PATH:$VISIT_DIR/bin
export SYMENGINE_ROOT=/opt/HPC/symengine
export SYMENGINE_LIBDIR=${SYMENGINE_ROOT}/lib64
export SYMENGINEF90_ROOT=/opt/HPC/symengine-f90
# I really don't understand why this is needed
# export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${SYMENGINE_LIBDIR}

%post
export PETSC_DIR=/opt/HPC/petsc
export PETSC_ARCH=arch-rocky-mpich-O
export PATH=$PETSC_DIR/bin:$PETSC_DIR/$PETSC_ARCH/bin:$PATH
export MEF90_DIR=/opt/HPC/mef90
export PATH=$MEF90_DIR/$PETSC_ARCH/bin:$MEF90_DIR/bin:$PATH
export PYTHONPATH=$MEF90_DIR/python:$PETSC_DIR/$PETSC_ARCH/lib:$PYTHONPATH
# export GMSH_DIR=/opt/HPC/gmsh-4.13.1-Linux64
# export PATH=$PATH:$GMSH_DIR/bin
# export VISIT_DIR=/opt/HPC/visit
# export PATH=$PATH:$VISIT_DIR/bin
export SYMENGINE_ROOT=/opt/HPC/symengine
export SYMENGINE_LIBDIR=${SYMENGINE_ROOT}/lib64
export SYMENGINEF90_ROOT=/opt/HPC/symengine-f90
# I really don't understand why this is needed
# export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${SYMENGINE_LIBDIR}

dnf install -y diffutils cmake procps make gcc gcc-c++ gfortran pkgconfig bzip2 git libtool automake autoconf cpio python3-pip gmp gmp-devel hwloc hwloc-devel vim 
### 2026-05-19: dnf update -y fails. commenting out for now 
# dnf update -y 

mkdir -p /opt/HPC/src

### SYMENGINE
git clone https://github.com/symengine/symengine.git /opt/HPC/src/symengine
mkdir -p /opt/HPC/src/symengine/build
cd /opt/HPC/src/symengine/build
cmake -DCMAKE_INSTALL_PREFIX=${SYMENGINE_ROOT} ..
make -j$(nproc) 
make install
### SYMENGINE-F90
git clone https://github.com/symengine/symengine.f90.git /opt/HPC/src/symengine-f90
mkdir -p /opt/HPC/src/symengine-f90/build
cd /opt/HPC/src/symengine-f90/build
cmake -DSymEngine_DIR=${SYMENGINE_ROOT} -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=${SYMENGINEF90_ROOT} -DCMAKE_POLICY_VERSION_MINIMUM=3.5 ..
make 
make install

### PETSc
git clone --single-branch --branch release https://gitlab.com/petsc/petsc.git ${PETSC_DIR}

cd ${PETSC_DIR}
./configure                       \
    --COPTFLAGS='-O3'   \
    --CXXOPTFLAGS='-O3' \
    --FOPTFLAGS='-O3'   \
    CFLAGS+='-Wimplicit-function-declaration -Wunused' \
    FFLAGS+='-ffree-line-length-none -fallow-argument-mismatch -Wunused' \
    --download-fblaslapack=1          \
    --download-exodusii=1             \
    --download-hdf5=1                 \
    --download-hypre=1                \
    --download-metis=1                \
    --download-mpich=1                \
    --download-netcdf=1               \
    --download-ml=1                   \
    --download-parmetis=1             \
    --download-pnetcdf=1              \
    --download-sowing=1               \
    --download-zlib=1                 \
    --with-debugging=0                \
    --with-exodusii-fortran-bindings  \
    --with-shared-libraries=1         \
    --with-x11=1
make PETSC_DIR=${PETSC_DIR} PETSC_ARCH=${PETSC_ARCH} all

### MEF90
# ENV PATH=${MEF90_DIR}/bin:${MEF90_DIR}/${PETSC_ARCH}/bin:${PETSC_DIR}/bin:${PETSC_DIR}/${PETSC_ARCH}/bin:$PATH
# ENV PYTHONPATH=${MEF90_DIR}/python
git clone --single-branch --branch main https://github.com/bourdin/mef90 ${MEF90_DIR}
cd ${MEF90_DIR}
make vDef
cd Utils
make all


